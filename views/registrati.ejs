<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/registrati.css">
    <script src="/javascripts/registrati.js"></script>
</head>
<body>

    <div class="login-container">
        <div class="login-box">
            <h2>Crea un account</h2>
            <p class="subtitle">Unisciti a noi, è gratis!</p>

            <% if (locals.error) { %>
                <div class="error-message">
                    <%= error %>
                </div>
            <% } %>

            <form action="/registrati" method="POST">
            <section>
                <label for="nome">Nome</label>
                <input type="text" id="nome" name="nome" placeholder="Mario" value="<%= locals.dati ? dati.nome : '' %>">
            </section>

                <section>
                    <label for="cognome">Cognome</label>
                    <input type="text" id="cognome" name="cognome" placeholder="Rossi" value="<%= locals.dati ? dati.cognome : '' %>">
                </section>

                <section>
                    <label for="email">Email</label>
                    <input type="text" id="email" name="email" placeholder="mariorossi@mail.com" value="<%= locals.dati ? dati.email : '' %>">
                </section>

                <section>
                    <label for="dataNascita">Data di nascita</label>
                    <input type="date" id="dataNascita" name="dataNascita" value="<%= locals.dati ? dati.dataNascita : '' %>">
                </section>

                <section>
                    <label>Sesso</label>
                    <div class="radio-group">
                        <input type="radio" id="maschio" name="sesso" value="maschio">
                        <label for="maschio">Maschio</label>
                        
                        <input type="radio" id="femmina" name="sesso" value="femmina">
                        <label for="femmina">Femmina</label>
                        
                        <input type="radio" id="molto" name="sesso" value="molto">
                        <label for="molto">Molto</label>
                    </div>
                </section>
                <section>
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" placeholder="••••••••">
                </section>

                <section>
                    <label for="confermaPassword">Conferma Password</label>
                    <input type="password" id="confermaPassword" name="confermaPassword" placeholder="••••••••">
                </section>

                <section>
                    <label for="username">Username</label>
                    <input type="text" id="username" name="username" placeholder="mariorossi2000" value="<%= locals.dati ? dati.username : '' %>">
                </section>

                <button type="submit" class="login-button">Registrati</button>
            </form>

            <footer>
                <p>Hai già un account? <a href="/login">Accedi qui</a></p>
            </footer>
        </div>
    </div>

</body>
</html>