<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/registrati.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>

    <div class="login-container">
        <div class="login-box">
            <h2>Crea un account</h2>
            <p class="subtitle">Unisciti a noi, è gratis!</p>

            <% if (locals.error) { %>
                <div class="error-message">
                    <%= error %>
                </div>
            <% } %>

            <form action="/registrati" method="POST">
            <section>
                <label for="nome">Nome</label>
                <input type="text" id="nome" name="nome" placeholder="Mario" value="<%= locals.dati ? dati.nome : '' %>">
            </section>

                <section>
                    <label for="cognome">Cognome</label>
                    <input type="text" id="cognome" name="cognome" placeholder="Rossi" value="<%= locals.dati ? dati.cognome : '' %>">
                </section>

                <section>
                    <label for="email">Email</label>
                    <input type="text" id="email" name="email" placeholder="mariorossi@mail.com" value="<%= locals.dati ? dati.email : '' %>">
                </section>

                <section>
                    <label for="dataNascita">Data di nascita</label>
                    <input type="date" id="dataNascita" name="dataNascita" value="<%= locals.dati ? dati.dataNascita : '' %>">
                </section>

                <section>
                    <label>Sesso</label>
                    <div class="radio-group">
                        <input type="radio" id="maschio" name="sesso" value="maschio" 
                            <%= (locals.dati && dati.sesso === 'maschio') ? 'checked' : '' %> required>
                        <label for="maschio">Maschio</label>
                        
                        <input type="radio" id="femmina" name="sesso" value="femmina" 
                            <%= (locals.dati && dati.sesso === 'femmina') ? 'checked' : '' %> required>
                        <label for="femmina">Femmina</label>
                        
                        <input type="radio" id="altro" name="sesso" value="altro" 
                            <%= (locals.dati && dati.sesso === 'altro') ? 'checked' : '' %> required>
                        <label for="altro">Altro</label>
                    </div>
                </section>

                <section>
                    <label for="password">Password</label>
                    <div class="password-wrapper">
                        <input type="password" id="password" name="password" placeholder="Crea una password">
                        <i class="fa-regular fa-eye toggle-password-reg"></i>
                    </div>
                </section>

                <section>
                    <label for="confirm_password">Conferma Password</label>
                    <div class="password-wrapper">
                        <input type="password" id="confermaPassword" name="confermaPassword" placeholder="Ripeti la password">
                        <i class="fa-regular fa-eye toggle-password-reg"></i>
                    </div>
                </section>

                <section>
                    <label for="username">Username</label>
                    <input type="text" id="username" name="username" placeholder="mariorossi2000" value="<%= locals.dati ? dati.username : '' %>">
                </section>

                <div class="privacy-container">
                    <input type="checkbox" id="privacy_accept" name="privacy_accept">
                    <label for="privacy_accept">
                        Ho letto e accetto l' <a href="/privacy" target="_blank">Informativa sulla Privacy</a> di NutriClash.
                    </label>
                </div>
                <button type="submit" class="login-button">Registrati</button>
            </form>



            <footer>
                <p>Hai già un account? <a href="/login">Accedi qui</a></p>
            </footer>
        </div>
    </div>
    <script src="/javascripts/registrati.js"></script>
    <script src="/javascripts/occhio.js"></script>
</body>
</html>
