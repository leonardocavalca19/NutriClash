<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/registrati.css">
    <script src="/javascripts/registrati.js"></script>
    <style>
        footer p {
            color: #666;
        }

        footer a {
            color: #007bff;
            font-weight: 600;
        }

        .età-container {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        #inputEta {
            width: 30%;
        }

        .radio-group {
            display: flex;
            flex-direction: row; 
            align-items: center;
            gap: 15px;         
            padding-top: 5px;
        }

        .radio-group input[type="radio"] {
            width: auto;        
            margin-right: 5px;
            cursor: pointer;
        }

        .radio-group label {
            display: inline;     
            font-weight: 400;    
            margin-bottom: 0;
            cursor: pointer;
        }

        .età-container input[type="range"] {
            width: 70%;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="login-box">
            <h2>Crea un account</h2>
            <p class="subtitle">Unisciti a noi, è gratis!</p>

            <% if (locals.error) { %>
                <div class="error-message">
                    <%= error %>
                </div>
            <% } %>

            <form action="/registrati" method="POST">
                <section>
                    <label for="Nome">Nome</label>
                    <input type="text" id="Nome" name="Nome" placeholder="Mario">
                </section>

                <section>
                    <label for="Cognome">Cognome</label>
                    <input type="text" id="Cognome" name="Cognome" placeholder="Rossi">
                </section>

                <section>
                    <label for="email">Email</label>
                    <input type="text" id="email" name="Email" placeholder="mariorossi@mail.com">
                </section>

                <section>
                    <label for="dataNascita">Data di nascita</label>
                    <input type="date" id="dataNascita" name="dataNascita">
                </section>

                <section>
                    <label>Sesso</label>
                    <div class="radio-group">
                        <input type="radio" id="maschio" name="sesso" value="maschio">
                        <label for="maschio">Maschio</label>
                        
                        <input type="radio" id="femmina" name="sesso" value="femmina">
                        <label for="femmina">Femmina</label>
                        
                        <input type="radio" id="molto" name="sesso" value="molto">
                        <label for="molto">Molto</label>
                    </div>
                </section>
                <section>
                    <label for="Password">Password</label>
                    <input type="password" id="password" name="password" placeholder="••••••••">
                </section>

                <section>
                    <label for="ConfermaPassword">Conferma Password</label>
                    <input type="password" id="confermaPassword" name="confermaPassword" placeholder="••••••••">
                </section>

                <button type="submit" class="login-button">Registrati</button>
            </form>

            <footer>
                <p>Hai già un account? <a href="/login">Accedi qui</a></p>
            </footer>
        </div>
    </div>

</body>
</html>