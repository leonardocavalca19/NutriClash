<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%title%></title>
    <link rel="stylesheet" href="/stylesheets/registrati.css">
    <script src="/javascripts/registrati.js"></script>
    <style>
        footer p {
            color: #666;
        }

        footer a {
            color: #007bff;
            font-weight: 600;
        }

        .età-container {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        #inputEta {
            width: 30%;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="login-box">
            <h2>Crea un account</h2>
            <p class="subtitle">Unisciti a noi, è gratis!</p>

            <% if (locals.error) { %>
                <div class="error-message">
                    <%= error %>
                </div>
            <% } %>

            <form action="/registrati" method="POST">
                <section>
                    <label for="Nome">Nome</label>
                    <input type="text" id="Nome" name="Nome" placeholder="Mario">
                </section>

                <section>
                    <label for="Cognome">Cognome</label>
                    <input type="text" id="Cognome" name="Cognome" placeholder="Rossi">
                </section>

                <section>
                    <label for="email">Email</label>
                    <input type="text" id="email" name="Email" placeholder="mariorossi@mail.com">
                </section>

                <section>
                    <label for="Eta">Seleziona la tua età:</label>
                    <div class="età-container">
                        <input type="range" id="rangeEta" min="0" max="100" value="25" oninput="inputEta.value = this.value">
                        <input type="number" id="inputEta" min="0" max="100" value="25"oninput="rangeEta.value = this.value">
                    </div>
                </section>
                <section>
                    <label for="Password">Password</label>
                    <input type="password" id="password" name="password" placeholder="••••••••">
                </section>

                <section>
                    <label for="ConfermaPassword">Conferma Password</label>
                    <input type="password" id="confermaPassword" name="confermaPassword" placeholder="••••••••">
                </section>

                <button type="submit" class="login-button">Registrati</button>
            </form>

            <footer>
                <p>Hai già un account? <a href="/login">Accedi qui</a></p>
            </footer>
        </div>
    </div>

</body>
</html>
