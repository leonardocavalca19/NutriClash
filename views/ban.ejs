<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Accesso Negato - Sei Bannato</title>
    <style>
        body {
    background-color: #121214;
    color: #ffffff;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    margin: 0;
}
.card {
    background-color: #1a1a1e;
    padding: 40px;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    text-align: center;
    max-width: 400px;
    border: 1px solid #ff4a4a;
}
h1 {
    color: #ff4a4a;
    margin-top: 0;
    font-size: 24px;
}
p {
    color: #a0a0a5;
    font-size: 16px;
}
.timer {
    font-size: 48px;
    font-weight: bold;
    color: #ffffff;
    margin: 20px 0;
    font-variant-numeric: tabular-nums;
    letter-spacing: 2px;
}
.badge {
    background-color: rgba(255, 74, 74, 0.1);
    color: #ff4a4a;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
    display: inline-block;
}
.info-text {
    font-size: 13px;
}
    </style>
</head>
<body>
    <div class="card">
        <span class="badge">Protezione Anti-Spam</span>
        <h1>Sei stato temporaneamente bloccato</h1>
        <p>Hai premuto il tasto troppe volte. Potrai riprovare tra:</p>
        <div class="timer" id="countdown">--:--</div>
        <p class="info-text">La pagina si ricaricherà automaticamente allo scadere del tempo.</p>
    </div>

    <script>
        let tempoRimanente = parseInt("<%= secondiTotali %>", 10);
        const timerElement = document.getElementById('countdown');

        function aggiornaTimer() {
            if (tempoRimanente <= 0) {
                timerElement.innerText = "00:00";
                setTimeout(() => { window.location.reload(); }, 1000);
                return;
            }

            const minuti = Math.floor(tempoRimanente / 60);
            const secondi = tempoRimanente % 60;

            const strMinuti = minuti < 10 ? '0' + minuti : minuti;
            const strSecondi = secondi < 10 ? '0' + secondi : secondi;

            timerElement.innerText = strMinuti + ':' + strSecondi;
            tempoRimanente--;
        }

        aggiornaTimer();
        setInterval(aggiornaTimer, 1000);
    </script>
</body>
</html>