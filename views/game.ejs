<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="./stylesheets/style.css">
    <link rel="stylesheet" href="./stylesheets/game.css">
    <script src="/javascripts/game.js"></script>
    <script src="/javascripts/resize.js"></script>
    <title><%= title %></title>
</head>
<body>
    <div class="app">
        <!-- SIDEBAR -->
        <aside class="sidebar" id="nav">
            <div class="logo">
                <img src="/logo.png" alt="LOGO">
            </div>
    
            <nav>
                <a href="/" >Home</a>
                <a href="/game" class="active">Gioca</a>
                <a href="/classifica">Classifica</a>
                <a href="/obiettivo">Il nostro obiettivo</a>
                <a href="/nutriscore">Nutri-score</a>
                <a href="/scontro">Scontro tra Prodotti</a>
            </nav>
    
            <div class="sidebar-footer">
                <a href="/contatti">Contatti</a>
                <a href="/privacy">Privacy</a>
                <a href="/login">Accedi</a>
                <a href="/account">Il mio account</a>
            </div>
        </aside>
        <div class="chat-divider" id="chat-divider"></div>
        <main class="main" id="main">

            <div class="scores-container" id="scores-container">
                <p>Tempo: </p><span id="timer">0:00</span>
                <p>Punteggio: </p><span id="punteggio">0</span>
            </div>

            <div class="container-game">
                <div class="element1" id="element1">
                    <img src="" alt="Prodotto 1" id="img-element1">
                    <p id="name-element1"></p>
                    <span class="nutriscore" id="score1"></span>
                </div>
                <p class="versus">VS</p>
                <div class="element2" id="element2">
                    <img src="" alt="Prodotto 2" id="img-element2">
                    <p id="name-element2"></p>
                    <span class="nutriscore" id="score2"></span>
                </div>
            </div>
        </main>
    </div>
</body>
</html>