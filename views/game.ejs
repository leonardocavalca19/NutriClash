<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="./stylesheets/style.css">
    <link rel="stylesheet" href="./stylesheets/game.css">
    <script src="/javascripts/game.js"></script>
    <script src="/javascripts/resize.js"></script>
    <title><%= title %></title>
</head>
<body>
    <div class="app">
        <%- include("navbar", {file: "game"} ) %>
        <div class="chat-divider" id="chat-divider"></div>
        <main class="main" id="main">
            <div class="scores-container" id="scores-container">
                <div class="scores">
                    <h1>Tempo: </h1><span class="timer" id="timer">0:00</span>
                </div>
                <div class="scores">
                    <h1>Punteggio: </h1><span class="punteggio" id="punteggio">0</span>
                </div>
            </div>

            <div class="container-game">
                <div class="element1" id="element1">
                    <div class="image-wrapper">
                        <img src="" alt="Prodotto 1" id="img-element1" class="image">
                        <span class="nutriscore" id="score1"></span>
                    </div>
                    <p id="name-element1"></p>
                </div>
                <p class="versus">VS</p>
                <div class="element2" id="element2">
                    <div class="image-wrapper">
                        <img src="" alt="Prodotto 2" id="img-element2" class="image">
                        <span class="nutriscore" id="score2"></span>
                    </div>
                    <p id="name-element2"></p>
                </div>
            </div>
            <%- include("footer") %>
        </main>
    </div>
</body>
</html>