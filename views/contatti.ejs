<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="/javascripts/resize.js"></script>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/nutriscore.css">
    <link rel="stylesheet" href="/stylesheets/contatti.css">
</head>
<body>

    <div class="app"> 
        <input type="checkbox" id="menu-toggle" class="menu-toggle">
        <label for="menu-toggle" class="hamburger">
            <span></span>
            <span></span>
            <span></span>
        </label>
        <aside class="sidebar" id="nav">
            <div class="logo">
                <img src="/logo.png" alt="LOGO">
            </div>
            <nav>
                <a href="/" >Home</a>
                <a href="/game">Gioca</a>
                <a href="/classifica">Classifica</a>
                <a href="/nutriscore">Nutri-score</a>
                <a href="/scontro">Scontro tra Prodotti</a>
            </nav>
                <div class="sidebar-footer">
                    <a href="/api">API Docs</a>
                    <a href="/contatti" class="active">Contatti</a>
                    <a href="/privacy">Privacy</a>
                    <% if(!user) { %> <a href="/login">Accedi</a> <% }  else {%><a href="/account">Il mio account</a><% } %>
                </div>
        </aside>
        <div class="chat-divider" id="chat-divider"></div>
        <main class="main" id="main">
            <header class="topbar">
                <h1>Il Team di NutriClash</h1>
                <p>Le menti dietro il progetto</p>
            </header>

            <section class="contenuto-nutri">
                
                <div class="griglia-team">
                    <div class="scheda-info scheda-membro">
                        <div class="avatar-cerchio">👤</div>
                        <h3>Sozzi Mattia </h3>
                        <p class="ruolo">Co-Fondatore & Sviluppatore</p>
                        <p>Studente di Informatica appassionato di tecnologie web e salute digitale. Collabora alla crescita e alla visione del progetto NutriClash.</p>
                        <a href="https://mail.google.com/mail/u/0/?tab=rm&ogbl#inbox" class="link-contatto" target="_blank">Contatti mail: smattia.sozzi@itis.pr.it</a>
                        <br>
                        <a href="https://github.com/Kimoilmagnifico" class="link-contatto" target="_blank">Profilo GitHub</a>
                    </div>

                    <div class="scheda-info scheda-membro">
                        <div class="avatar-cerchio">👤</div>
                        <h3>Cavalca Leonardo</h3>
                        <p class="ruolo">Co-Fondatore & Sviluppatore</p>
                        <p>Studente di Informatica con un forte interesse per l'analisi dei dati e l'esperienza utente. Collabora alla crescita del progetto NutriClash.</p>
                        <a href="https://mail.google.com/mail/u/0/?tab=rm&ogbl#inbox" class="link-contatto" target="_blank">Contatti mail: sleonardo.cavalca@itis.pr.it</a>
                        <br>
                        <a href="https://github.com/leonardocavalca19" class="link-contatto" target="_blank">Profilo GitHub</a>
                    </div>
                </div>

                <div class="scheda-info testo-centrato">
                    <h3>Il Progetto</h3>
                    <p>NutriClash è stato sviluppato come progetto per sensibilizzare sul tema della salute e del benessere. <br> 
                    Il codice sorgente è disponibile su <strong>GitHub</strong> per scopi didattici.</p>
                    <div class="pulsanti-social">
                        <a href="https://github.com/leonardocavalca19/NutriClash" class="pulsante-secondario" target="_blank">GitHub Repository</a>
                    </div>
                </div>

            </section>
        </main>
    </div>

</body>
</html>