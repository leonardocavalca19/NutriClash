<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="/javascripts/resize.js"></script>
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
    <body>

        <div class="app">

            <!-- SIDEBAR -->
            <aside class="sidebar" id="nav">
                <div class="logo">
                    <img src="/logo.png" alt="LOGO">
                </div>

                <nav>
                    <a href="/" class="active">Home</a>
                    <a href="/game">Gioca</a>
                    <a href="#">Classifica</a>
                    <a href="/obbiettivo">Il nostro obiettivo</a>
                    <a href="/nutriscore">Nutri-score</a>
                    <a href="/scontro">Scontro tra Prodotti</a>
                </nav>

                <div class="sidebar-footer">
                    <a href="#">Contatti</a>
                    <a href="#">Privacy</a>
                    <a href="/login">Accedi</a>
                </div>
            </aside>
            <div class="chat-divider" id="chat-divider"></div>
            <!-- MAIN -->
            <main class="main" id="main">

                <!-- HEADER -->
                <header class="topbar">
                    <h1>NutriClash</h1>
                    <a class="play-btn" href="/login">Accedi</a>
                </header>

                <!-- HERO -->
                <section class="hero">
                    <div class="hero-text">
                        <h2>Qual è più salutare?</h2>
                        <p>
                            Metti alla prova il tuo intuito: quale tra qeusti due cibi è più salutare?
                        </p>
                        <a class="cta" href="/game">Inizia subito</a>
                    </div>

                    <div class="hero-image">
                        <img src="images/hero-image.jpg" alt="preview">
                    </div>
                </section>

                <!-- INFO SECTION -->
                <section class="info">
                    <div class="card">
                        <h3>🎯 Semplice</h3>
                        <p>Due scelte, una decisione.</p>
                    </div>

                    <div class="card">
                        <h3>🔥 Addictive</h3>
                        <p>Una volta iniziato non smetti.</p>
                    </div>

                    <div class="card">
                        <h3>🏆 Sfida</h3>
                        <p>Batti il tuo record.</p>
                    </div>
                </section>

            </main>

        </div>

    </body>
</html>
