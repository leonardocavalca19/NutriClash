<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/registrati.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>

    <div class="login-container">
        <div class="login-box">
            <h2>Bentornato</h2>
            <p class="subtitle">Inserisci le tue credenziali per accedere</p>

            <% if (locals.error) { %>
                <div class="error-message">
                    <%= error %>
                </div>
            <% } %>

            <form action="/login" method="POST">
                <section>
                    <label for="email_username">Email o Username</label>
                    <input type="text" id="email_username" name="email_username" placeholder="mariorossi2000@mail.com / mross2000ilpro ">
                </section>

                <section>
                    <label for="password">Password</label>
                    <div class="password-wrapper">
                        <input type="password" id="password" name="password" placeholder="••••••••">
                        <i class="fa-regular fa-eye" id="togglePassword"></i>
                    </div>
                </section>

                <button type="submit" class="login-button">Accedi</button>
            </form>

            <footer>
                <p>Non hai un account? <a href="/registrati">Registrati</a></p>
            </footer>
        </div>
    </div>
    <script src="/javascripts/occhio.js"></script>

</body>
</html>
