<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%title%></title>
    <link rel="stylesheet" href="/stylesheets/registrati.css">
    <script src="/javascripts/login.js"></script>
</head>
<body>

    <div class="login-container">
        <div class="login-box">
            <h2>Bentornato</h2>
            <p class="subtitle">Inserisci le tue credenziali per accedere</p>

            <% if (locals.error) { %>
                <div class="error-message">
                    <%= error %>
                </div>
            <% } %>

            <form action="/login" method="POST">
                <section>
                    <label for="email">Email</label>
                    <input type="text" id="email" name="email" placeholder="esempio@mail.com">
                </section>

                <section>
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" placeholder="••••••••">
                </section>

                <button type="submit" class="login-button">Accedi</button>
            </form>

            <footer>
                <p>Non hai un account? <a href="/registrati">Registrati</a></p>
            </footer>
        </div>
    </div>

</body>
</html>