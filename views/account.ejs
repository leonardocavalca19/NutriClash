<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/account.css">
    <script src="/javascripts/resize.js"></script>
    <script src="/javascripts/account.js"></script>
</head>
<body>

    <div class="app">
        <%- include("navbar", {file: "account"} ) %>
        <div class="chat-divider" id="chat-divider"></div>
        <main class="main">
            <header class="topbar">
                <h1>Il Mio Profilo</h1>
                <p>Gestione delle informazioni personali</p>
            </header>

            <section class="contenuto-principale">
                
                <% if (locals.success) { %>
                    <div class="alert alert-success" style="background-color: #d4edda; color: #155724; padding: 10px; border-radius: 5px; margin-bottom: 15px; border: 1px solid #c3e6cb;">
                        <%= success %>
                    </div>
                <% } %>
                <% if (locals.error) { %>
                    <div class="alert alert-danger" style="background-color: #f8d7da; color: #721c24; padding: 10px; border-radius: 5px; margin-bottom: 15px; border: 1px solid #f5c6cb;">
                        <%= error %>
                    </div>
                <% } %>
                
                <div class="scheda-profilo">
                    <div class="sezione-avatar">
                        <div class="avatar-circle">
                            <img src="/images/icona_utente.png" alt="Avatar Utente" class="user-img-local">
                        </div>
                        <h2 class="username-display">@<%= user.username %></h2>
                    </div>

                    <div class="sezione-dati">
                        <div class="riga-dato">
                            <label>Nome e Cognome</label>
                            <p><%= user.nome %> <%= user.cognome %></p>
                        </div>
                        <div class="riga-dato">
                            <label>Email</label>
                            <p><%= user.email %></p>
                        </div>
                        <div class="riga-dato">
                            <label>Data di Nascita</label>
                            <p><%= user.data_nascita %></p>
                        </div>
                        <div class="riga-dato">
                            <label>Genere</label>
                            <p><%= user.sesso %></p>
                        </div>
                    </div>
                </div>

                <% if(user.ruolo !== "user") { %>
                    <div class="box-admin">
                        <div class="testo">
                            <h4>Amministratore</h4>
                            <p>Passa al pannello amministratore</p>
                        </div>
                        <form action="/admin" method="GET">
                            <button type="submit" class="btn-admin">Admin</button>
                        </form>
                    </div>
                <% } %>

                <div class="box-logout">
                    <div class="testo">
                        <h4>Esci</h4>
                        <p>Effettua il logout</p>
                    </div>
                    <form action="/login/logout" method="DELETE">
                        <button type="submit" class="btn-logout">Logout</button>
                    </form>
                </div>

                <div class="box-danger">
                    <div class="testo">
                        <h4>Elimina Profilo</h4>
                        <p>Rimuovi permanentemente i tuoi dati dal server.</p>
                    </div>
                    <button data-username="<%= user.username %>" id="btn-elimina" class="btn-elimina">Elimina</button>
                </div>

                <div class="api-section">
                    <div class="api-header">
                        <h4 class="api-title">Gestione Chiavi API</h4>
                        <p class="api-subtitle">Genera e amministra le tue chiavi di accesso per le funzionalità esterne avanzate.</p>
                    </div>

                    <form action="/account/request-api-key" method="POST" style="margin-bottom: 20px;">
                        <button type="submit" class="btn-api">Genera Nuova Chiave API</button>
                    </form>

                    <% if (locals.apiKeys && apiKeys.length > 0) { %>
                        <div class="api-container">
                            
                            <% apiKeys.forEach(function(item) { %>
                                <div class="api-row <%= item.attiva ? 'stato-attiva' : 'stato-disattivata' %>">
                                    
                                    <div class="api-info">
                                        <code class="api-key-code"><%= item.key %></code>
                                        <span class="status-badge <%= item.attiva ? 'attiva' : 'disattivata' %>">
                                            <%= item.attiva ? '● Attiva' : '○ Disattivata' %>
                                        </span>
                                    </div>

                                    <div class="api-actions">
                                        <form action="/account/toggle-api-key" method="POST">
                                            <input type="hidden" name="apiKey" value="<%= item.key %>">
                                            <input type="hidden" name="statoAttuale" value="<%= item.attiva %>">
                                            <button type="submit" class="btn-toggle-state">
                                                <%= item.attiva ? 'Disattiva' : 'Attiva' %>
                                            </button>
                                        </form>

                                        <button data-key="<%= item.key %>" type="submit" class="btn-delete-key">
                                            Elimina
                                        </button>
                                    </div>

                                </div>
                            <% }); %>
                            
                        </div>
                    <% } else { %>
                        <p style="color: #666; font-style: italic; font-size: 0.9rem;">Non hai ancora generato nessuna chiave API.</p>
                    <% } %>
                </div>

            </section>
            <%- include("footer") %>
        </main>
    </div>

</body>
</html>