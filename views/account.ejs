<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/account.css">
    <script src="/javascripts/resize.js"></script>
</head>
<body>

    <div class="app">
        <aside class="sidebar" id="nav">
            <div class="logo">
                <img src="/logo.png" alt="LOGO">
            </div>
            <nav>
                <a href="/" >Home</a>
                <a href="/game">Gioca</a>
                <a href="/classifica">Classifica</a>
                <a href="/obiettivo">Il nostro obiettivo</a>
                <a href="/nutriscore">Nutri-score</a>
                <a href="/scontro">Scontro tra Prodotti</a>
            </nav>
            <div class="sidebar-footer">
                <a href="/api">API Docs</a>
                <a href="/contatti">Contatti</a>
                <a href="/privacy">Privacy</a>
                <a href="/account" class="active">Il mio account</a>
            </div>
        </aside>
        <div class="chat-divider" id="chat-divider"></div>
        <main class="main">
            <header class="topbar">
                <h1>Il Mio Profilo</h1>
                <p>Gestione delle informazioni personali</p>
            </header>

            <section class="contenuto-principale">
                
                <div class="scheda-profilo">
                    <div class="sezione-avatar">
                        <div class="avatar-circle">
                            <img src="/images/icona_utente.png" alt="Avatar Utente" class="user-img-local">
                        </div>
                        <h2 class="username-display">@<%= user.username %></h2>
                    </div>

                    <div class="sezione-dati">
                        <div class="riga-dato">
                            <label>Nome e Cognome</label>
                            <p><%= user.nome %> <%= user.cognome %></p>
                        </div>
                        <div class="riga-dato">
                            <label>Email</label>
                            <p><%= user.email %></p>
                        </div>
                        <div class="riga-dato">
                            <label>Data di Nascita</label>
                            <p><%= user.data_nascita %></p>
                        </div>
                        <div class="riga-dato">
                            <label>Genere</label>
                            <p><%= user.sesso %></p>
                        </div>
                    </div>
                </div>

                <% if(user.ruolo === "owner") { %>
                    <div class="box-admin">
                        <div class="testo">
                            <h4>Amministratore</h4>
                            <p>Passa al pannello amministratore</p>
                        </div>
                        <form action="/admin" method="GET">
                            <button type="submit" class="btn-admin">Admin</button>
                        </form>
                    </div>
                <% } %>

                <div class="box-logout">
                    <div class="testo">
                        <h4>Esci</h4>
                        <p>Effettua il logout</p>
                    </div>
                    <form action="/login/logout" method="POST">
                        <button type="submit" class="btn-logout">Logout</button>
                    </form>
                </div>

                <div class="box-danger">
                    <div class="testo">
                        <h4>Elimina Profilo</h4>
                        <p>Rimuovi permanentemente i tuoi dati dal server.</p>
                    </div>
                    <form action="/account/delete" method="POST" onsubmit="return confirm('Vuoi davvero cancellare il tuo account NutriClash?');">
                        <button type="submit" class="btn-elimina">Elimina</button>
                    </form>
                </div>

                <div class="box-request">
                    <div class="testo">
                        <h4>Richiedi la chiave API</h4>
                        <p>Richiedi una chiave API personalizzata per accedere alle funzionalità avanzate.</p>
                    </div>

                    <% if (typeof apiKey !== 'undefined' && apiKey) { %>
                        <div class="api-display-box">
                            <strong>La tua chiave:</strong> 
                            <code><%= apiKey %></code>
                        </div>
                    <% } %>

                    <form action="/account/request-api-key" method="POST">
                        <button type="submit" class="btn-api">
                            <%= (typeof apiKey !== 'undefined' && apiKey) ? 'Rigenera Chiave' : 'Richiedi Chiave' %>
                        </button>
                    </form>
                </div>




            </section>
        </main>
    </div>

</body>
</html>