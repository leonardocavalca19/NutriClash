<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/admin.css">
    <script src="/javascripts/resize.js"></script>
    <script src="/javascripts/admin.js"></script>
    <title><%= title %></title>
</head>
<body>
    <div class="app">
        <%- include("navbar", {file: "admin"} ) %>
        <div class="chat-divider" id="chat-divider"></div>
        <main class="main">
            <header class="topbar">
                <h1>Pannello amministratore</h1>
            </header>
            <div class="users-grid">
                <% for(let i=0; i<users.length; i++) { %>
                    <div class="user-box">
                        <p class="username"><strong>Username:</strong> <%= users[i].username %></p>
                        <p class="username"><strong>Nome:</strong> <%= users[i].nome %></p>
                        <p class="username"><strong>Cognome:</strong> <%= users[i].cognome %></p>
                        <p class="username"><strong>Email:</strong> <%= users[i].email %></p>
                        <div class="ruolo">
                            <p><strong>Ruolo:</strong> </p>
                            <select
                                class="ruolo-select"
                                data-username="<%= users[i].username %>"
                                <%= (
                                        (user.ruolo !== "owner" && users[i].ruolo === "owner") || (user.username === users[i].username)
                                    ) ? "disabled" : "" %>
                            >
                                <option
                                    value="user"
                                    <%= users[i].ruolo === "user" ? "selected" : "" %>
                                >
                                    User
                                </option>
                                <option
                                    value="admin"
                                    <%= users[i].ruolo === "admin" ? "selected" : "" %>
                                >
                                    Admin
                                </option>
                                <% if(user.ruolo === "owner" || users[i].ruolo === "owner") { %>
                                    <option
                                        value="owner"
                                        <%= users[i].ruolo === "owner" ? "selected" : "" %>
                                    >
                                        Owner
                                    </option>
                                <% } %>
                            </select>
                        </div>
                        <button class="delete" data-username="<%= users[i].username %>" <% if((user.ruolo === "admin" && users[i].ruolo === "owner") || (user.username === users[i].username) || (users[i].username === "owner")) { %> disabled <% } %> >Elimina</button>
                    </div>
                <% } %>
            </div>
            <%- include("footer") %>
        </main>
    </div>
</body>
</html>