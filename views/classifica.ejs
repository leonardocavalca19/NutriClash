<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <title>Classifica - NutriClash</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/account.css">
    <link rel="stylesheet" href="/stylesheets/classifica.css">
    <style>
        .label-mini {
            font-size: 0.7rem;
            color: #95a5a6;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-top: 10px;
        }

        .punteggio-recap {
            font-weight: bold;
            color: #7f8c8d;
            margin-top: 5px;
        }

        .tabella-ranking {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        .tabella-ranking th {
            text-align: left;
            padding: 12px 15px;
            background-color: #f8f9fa;
            color: #2c3e50;
            border-bottom: 2px solid #28a745;
        }

        .col-rank {
            font-weight: bold;
            color: #28a745;
            width: 60px;
        }

        .riga-utente {
            background-color: #f1f8f1 !important; /* Verde chiarissimo per evidenziare te stesso */
            font-weight: bold;
        }

        .separatore {
            text-align: center;
            color: #bdc3c7;
            font-size: 1.2rem;
            background-color: #fff;
        }

.tabella-ranking {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        background-color: #ffffff; /* Sfondo della tabella forzato a bianco */
    }

    /* Intestazione: Sfondo grigio chiaro, Testo blu scuro */
    .tabella-ranking th {
        text-align: left;
        padding: 12px 15px;
        background-color: #f8f9fa;
        color: #2c3e50 !important; /* !important assicura che non resti bianco */
        border-bottom: 2px solid #28a745;
        font-weight: bold;
    }

    /* Celle: Testo grigio molto scuro (quasi nero) */
    .tabella-ranking td {
        padding: 12px 15px;
        border-bottom: 1px solid #f1f1f1;
        color: #333333 !important; /* Forza il testo a essere visibile */
    }

    /* Forza il colore anche per i tag strong e span dentro la tabella */
    .tabella-ranking td strong, 
    .tabella-ranking td span:not(.tempo-badge) {
        color: #333333 !important;
    }

    .col-rank {
        font-weight: bold;
        color: #28a745 !important; /* Posizione in verde */
        width: 60px;
    }

    .riga-utente {
        background-color: #f1f8f1 !important; 
        color: #155724 !important; /* Testo verde scuro per la tua riga */
    }

    .tempo-badge {
        font-size: 0.85rem;
        color: #444444 !important; /* Testo del badge tempo */
        background: #e9ecef;
        padding: 4px 10px;
        border-radius: 10px;
        display: inline-block;
    }

    /* Se il testo è ancora bianco, questo è il "colpo di grazia" */
    .tabella-ranking * {
        text-shadow: none !important;
    }
    </style>
</head>
<body>

    <div class="app">
        <aside class="sidebar">
            <div class="logo"><img src="/logo.png" alt="LOGO"></div>
            <nav>
                <a href="/" >Home</a>
                <a href="/game">Gioca</a>
                <a href="/classifica"  class="active">Classifica</a>
                <a href="/obiettivo">Il nostro obiettivo</a>
                <a href="/nutriscore">Nutri-score</a>
                <a href="/scontro">Scontro tra Prodotti</a>
            </nav>
            <div class="sidebar-footer">
                <a href="/contatti">Contatti</a>
                <a href="/privacy">Privacy</a>
                <a href="/login">Accedi</a>
                <a href="/account">Il mio account</a>
            </div>
        </aside>

        <main class="main">
            <header class="topbar">
                <h1>Classifica Mondiale</h1>
                <p>I migliori esperti di Nutri-Score della community</p>
            </header>

            <section class="contenuto-principale">
                <div class="scheda-profilo">

                    <div class="sezione-dati">
                        <table class="tabella-ranking">
                            <thead>
                                <tr>
                                    <th>Pos</th>
                                    <th>Nick</th>
                                    <th>Punteggio</th>
                                    <th>Tempo</th>
                                </tr>
                            </thead>
                        <tbody>
                            <% 
                                const top10 = classifica.slice(0, 10); // Assumiamo sia già ordinata dalla query SQL
                                let currentRank = 1;
                                let userInTop10 = false; // Flag per vedere se l'utente loggato è già visualizzato
                                
                                top10.forEach((player, index) => { 
                                    if (index > 0) {
                                        const prevPlayer = top10[index - 1];
                                        if (!(player.punteggio === prevPlayer.punteggio && player.tempo === prevPlayer.tempo)) {
                                            currentRank = index + 1;
                                        }
                                    }
                                    if (user && player.username === user.username) { userInTop10 = true; }
                            %>
                                <tr class="<%= (user && player.username === user.username) ? 'riga-utente' : '' %>">
                                    <td class="col-rank"><%= currentRank %>°</td>
                                    <td>@<%= player.username %></td>
                                    <td><strong><%= player.punteggio %></strong> pts</td>
                                    <td><span class="tempo-badge"><%= player.tempo %>s</span></td>
                                </tr>
                            <% }); %>

                            <% /* SE L'UTENTE È LOGGATO MA NON ERA NELLA TOP 10 */ %>
                            <% if (user && !userInTop10) { %>
                                <tr>
                                    <td colspan="4" class="separatore">...</td>
                                </tr>
                                <tr class="riga-utente">
                                    <td class="col-rank"><%= user.posizione_reale %>°</td>
                                    <td>@<%= user.username %></td>
                                    <td><strong><%= user.punteggio %></strong> pts</td>
                                    <td><span class="tempo-badge"><%= user.tempo %>s</span></td>
                                </tr>
                            <% } %>
                        </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </main>
    </div>

</body>
</html>