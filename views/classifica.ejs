<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <title>Classifica - NutriClash</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/account.css">
    <link rel="stylesheet" href="/stylesheets/classifica.css">
    <style>
        
    </style>
</head>
<body>
    <div class="app">
        <input type="checkbox" id="menu-toggle" class="menu-toggle">
        <label for="menu-toggle" class="hamburger">
            <span></span>
            <span></span>
            <span></span>
        </label>
        <aside class="sidebar">
            <div class="logo"><img src="/logo.png" alt="LOGO"></div>
            <nav>
                <a href="/" >Home</a>
                <a href="/game">Gioca</a>
                <a href="/classifica"  class="active">Classifica</a>
                <a href="/obiettivo">Il nostro obiettivo</a>
                <a href="/nutriscore">Nutri-score</a>
                <a href="/scontro">Scontro tra Prodotti</a>
            </nav>
            <div class="sidebar-footer">
                <a href="/api">API Docs</a>
                <a href="/contatti">Contatti</a>
                <a href="/privacy">Privacy</a>
                <% if(!user) { %> <a href="/login">Accedi</a> <% }  else {%><a href="/account">Il mio account</a><% } %>
            </div>
        </aside>
        <div class="chat-divider" id="chat-divider"></div>
        <main class="main">
            <header class="topbar">
                <h1>Classifica Generale</h1>
                <p>I migliori esperti di Nutri-Score della community</p>
            </header>

            <section class="contenuto-principale">
                <div class="scheda-profilo">

                    <div class="sezione-dati">
                        <table class="tabella-ranking">
                            <thead>
                                <tr>
                                    <th>Posizione</th>
                                    <th>Nickname</th>
                                    <th>Punteggio</th>
                                    <th>Tempo</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% 
                                    const top10 = classifica.slice(0, MAX_LENGTH);
                                    let rankCorrente = 1;       //Campo per aumentare man mano il rank
                                    let utentiInTop10 = false;  //Campo per vedere se l'utente loggato è già visualizzato
                                    
                                    
                                    top10.forEach((player, index) => {      // Ciclo per visualizzare la top 10 con gestione dei pari merito
                                        if (index > 0) {            
                                            const precPlayer = top10[index - 1];       
                                            if (!(player.punteggio === precPlayer.punteggio && player.tempo === precPlayer.tempo)) {
                                                rankCorrente = index + 1;
                                            }
                                        }
                                        
                                        if (user && player.username === user.username) { utentiInTop10 = true; }    //Controllo se l'utente loggato è presente nella top 10 per evitare di visualizzarlo due volte
                                %>
                                    <tr class="<%= (user && player.username === user.username) ? 'riga-utente' : '' %>">
                                        <td class="col-rank"><%= rankCorrente %>°</td>
                                        <td>
                                            <% if(user && player.username === user.username) {%>
                                                <strong>@<%= player.username %></strong>
                                            <% } else { %>
                                                @<%= player.username %>
                                            <% } %>
                                        </td>
                                        <td><strong><%= player.punteggio %></strong> pts</td>
                                        <td><span class="tempo-badge"><%= Math.floor(player.tempo/60) + ":" + (player.tempo%60<10?0:"") + player.tempo%60 %></span></td>
                                    </tr>
                                <% }); %>

                                <!-- se l'utente è loggato ma non era nella top 10 -->
                                <% if (userRow) { %>
                                    <tr>
                                        <td colspan="4" class="separatore">...</td>
                                    </tr>
                                    <tr class="riga-utente">
                                        <td class="col-rank"><%= posizione %>°</td>
                                        <td><strong>@<%= userRow.username %></strong></td>
                                        <td><strong><%= userRow.punteggio %></strong> pts</td>
                                        <td><span class="tempo-badge"><%= Math.floor(userRow.tempo/60) + ":" + (userRow.tempo%60<10?0:"") + userRow.tempo%60 %></span></td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="registerTo">
                    <% if(!user) { %>
                        <p>
                            <a href="/registrati">Registrati</a> per salvare i tuoi progressi, 
                            oppure <a href="/accedi">Accedi</a> per visualizzare i tuoi risultati!
                        </p>
                    <% } %>
                </div>
            </section>
        </main>
    </div>
</body>
</html>