<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/account.css">
    <link rel="stylesheet" href="/stylesheets/classifica.css">
    <style>
        
    </style>
</head>
<body>
    <div class="app">
        <%- include("navbar", {file: "classifica"} ) %>
        <div class="chat-divider" id="chat-divider"></div>
        <main class="main">
            <header class="topbar">
                <h1>Classifica Generale</h1>
                <p>I migliori esperti di Nutri-Score della community</p>
            </header>

            <section class="contenuto-principale">
                <div class="scheda-profilo">

                    <div class="sezione-dati">
                        <table class="tabella-ranking">
                            <thead>
                                <tr>
                                    <th>Posizione</th>
                                    <th>Nickname</th>
                                    <th>Punteggio</th>
                                    <th>Tempo</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% classifica.forEach((player, index) => { %>
                                    <tr class="<%= (user && player.username === user.username) ? 'riga-utente' : '' %>">
                                        <td><%= index + 1 %>°</td>
                                        <td>
                                            <% if(user && player.username === user.username) { %>
                                                <strong>@<%= player.username %></strong>
                                            <% } else { %>
                                                @<%= player.username %>
                                            <% } %>
                                        </td>
                                        <td><strong><%= player.punteggio %></strong></td>
                                        <td>
                                            <%= Math.floor(player.tempo / 60) %>:<%= (player.tempo % 60 < 10 ? "0" : "") + (player.tempo % 60) %>
                                        </td>
                                    </tr>
                                <% }) %>
                                <!-- UTENTE FUORI TOP -->
                                <% if (userRow && posizione > MAX_LENGTH) { %>
                                    <tr>
                                        <td colspan="4" class="separatore">...</td>
                                    </tr>
                                    <tr class="riga-utente">
                                        <td><%= posizione %>°</td>
                                        <td><strong>@<%= userRow.username %></strong></td>
                                        <td><strong><%= userRow.punteggio %></strong></td>
                                        <td>
                                            <%= Math.floor(userRow.tempo / 60) %>:
                                            <%= (userRow.tempo % 60 < 10 ? "0" : "") + (userRow.tempo % 60) %>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="registerTo">
                    <% if(!user) { %>
                        <p>
                            <a href="/registrati">Registrati</a> per salvare i tuoi progressi, 
                            oppure <a href="/accedi">Accedi</a> per visualizzare i tuoi risultati!
                        </p>
                    <% } %>
                </div>
            </section>
            <%- include("footer") %>
        </main>
    </div>
</body>
</html>